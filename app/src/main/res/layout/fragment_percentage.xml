<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/percentInputof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16sp"
            android:textSize="25sp"
            android:background="#444444"
            android:hint="     "
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="% of"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_margin="16sp"/>

        <EditText
            android:id="@+id/numberInputof"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16sp"
            android:textSize="25sp"
            android:background="#444444"
            android:hint="     "
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ="
            android:textColor="@color/white"
            android:textSize="25sp"
            android:layout_margin="16sp"/>

        <TextView
            android:id="@+id/percentofANS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16sp"
            android:text=""
            android:textColor="@color/white"
            android:textSize="25sp" />
    </LinearLayout>
    <Button
        android:id="@+id/percentofButton"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculate"
        android:background="#9A63FF"
        android:textColor="#FFFFFF"
        android:textSize="25sp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/numberInputiswhatof1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16sp"
            android:textSize="25sp"
            android:background="#444444"
            android:hint="    "
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="is what % of"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_margin="16sp"/>

        <EditText
            android:id="@+id/numberInputiswhatof2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16sp"
            android:textSize="25sp"
            android:background="#444444"
            android:hint="    "
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ="
            android:textColor="@color/white"
            android:textSize="25sp"
            android:layout_margin="16sp"/>

        <TextView
            android:id="@+id/iswhatpercentofANS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="25sp"
            android:layout_margin="16sp"
            android:textColor="@color/white"/>
    </LinearLayout>
    <Button
        android:id="@+id/iswhatpercentofButton"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculate"
        android:background="#9A63FF"
        android:textColor="#FFFFFF"
        android:textSize="25sp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/numberInputisofwhat1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16sp"
            android:textSize="25sp"
            android:background="#444444"
            android:hint="    "
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="is"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_margin="16sp"/>

        <EditText
            android:id="@+id/numberInputisofwhat2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="16sp"
            android:textSize="25sp"
            android:background="#444444"
            android:hint="     "
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="% of what  ="
            android:textColor="@color/white"
            android:textSize="20sp"
            android:layout_margin="16sp"/>

        <TextView
            android:id="@+id/ispercentofwhatANS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="25sp"
            android:layout_margin="16sp"
            android:textColor="@color/white"/>
    </LinearLayout>
    <Button
        android:id="@+id/ispercentofwhatButton"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculate"
        android:background="#9A63FF"
        android:textColor="#FFFFFF"
        android:textSize="25sp" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#CCCCCC"/>



</LinearLayout>